        <url-pattern>/admin/delete-patient</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AdminAddDoctorServlet</servlet-name>
        <servlet-class>admin.AdminAddDoctorServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAddDoctorServlet</servlet-name>
        <url-pattern>/admin/add-doctor</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>AdminAddPatientServlet</servlet-name>
        <servlet-class>admin.AdminAddPatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAddPatientServlet</servlet-name>
        <url-pattern>/admin/add-patient</url-pattern>
    </servlet-mapping>
    
    <servlet>
